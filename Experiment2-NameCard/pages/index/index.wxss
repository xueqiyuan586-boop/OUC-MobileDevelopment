.page{

  padding:40rpx;
  
  background:#f7f5f0;
  
  min-height:100vh;
  
  }
  
  
  /* 顶部图片 */
  
  .banner{
  
  width:100%;
  
  height:360rpx;
  
  border-radius:8rpx;
  
  }
  
  
  /* 个人信息 */
  
  .intro{
  
  padding:60rpx 20rpx 40rpx;
  
  }
  
  
  
  .name{
  
  display:block;
  
  font-size:58rpx;
  
  font-weight:600;
  
  letter-spacing:4rpx;
  
  color:#222;
  
  }
  
  
  
  .en{
  
  display:block;
  
  margin-top:15rpx;
  
  font-size:26rpx;
  
  color:#888;
  
  letter-spacing:2rpx;
  
  }
  
  
  
  .school{
  
  display:block;
  
  margin-top:35rpx;
  
  font-size:32rpx;
  
  color:#333;
  
  }
  
  
  
  .college{
  
  display:block;
  
  margin-top:10rpx;
  
  font-size:28rpx;
  
  color:#777;
  
  }
  
  
  
  
  
  /* 模块 */
  
  .section{
  
  padding:45rpx 20rpx;
  
  border-top:
  
  1rpx solid #ddd;
  
  }
  
  
  
  
  .section-title{
  
  display:block;
  
  font-size:28rpx;
  
  letter-spacing:3rpx;
  
  color:#777;
  
  margin-bottom:30rpx;
  
  font-weight:bold;
  
  }
  
  
  
  
  .content{
  
  display:block;
  
  font-size:30rpx;
  
  line-height:55rpx;
  
  color:#444;
  
  }
  
  
  
  .skill-box{
  
  display:flex;
  
  flex-wrap:wrap;
  
  }
  
  
  
  .skill-box text{
  
  
  padding:
  
  15rpx 30rpx;
  
  
  margin:
  
  0 15rpx 15rpx 0;
  
  
  border-radius:50rpx;
  
  
  background:#ebe7df;
  
  
  font-size:28rpx;
  
  
  color:#444;
  
  
  }
  
  
  
  .project-title{
  
  display:block;
  
  font-size:34rpx;
  
  font-weight:bold;
  
  color:#222;
  
  margin-top:25rpx;
  
  margin-bottom:15rpx;
  
  }
  .share-btn {
    width: 90%;
    margin: 40rpx auto;
    height: 88rpx;
  
    background-color: #222;
    color: #ffffff;
  
    font-size: 28rpx;
    border-radius: 16rpx;
  
    display: flex;
    align-items: center;
    justify-content: center;
  }